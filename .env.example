# Copy values into your shell/environment (this file is not loaded automatically).
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
# Required for production: generate with secrets.token_urlsafe(64).
DJANGO_SECRET_KEY=
# Optional. Default SQLite; PostgreSQL example:
# DATABASE_URL=postgresql://toolsathi:password@localhost:5432/toolsathi
# Set only when your trusted reverse proxy overwrites X-Forwarded-Proto.
TRUST_PROXY_HTTPS=false
# RESULT_DIR=/private/ephemeral/toolsathi-results
# APK_DIR=/srv/toolsathi/artifacts
