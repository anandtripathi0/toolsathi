# Development values. This example is never loaded automatically.
# For PythonAnywhere use scripts/deploy_pythonanywhere.sh; it creates the private
# /home/anandtrip22/.toolsathi.env file with a generated production secret.
# To opt in explicitly: TOOLSATHI_ENV_FILE=/absolute/private/path/outside/checkout
# POSIX environment files must be owned by the running user with permissions 0600.
# Format: KEY=VALUE, optional matching quotes; values are literal, never expanded.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
# Required for production: generate with secrets.token_urlsafe(64).
DJANGO_SECRET_KEY=
# Optional. Default SQLite; PostgreSQL example:
# DATABASE_URL=postgresql://toolsathi:password@localhost:5432/toolsathi
# Set only when your trusted reverse proxy overwrites X-Forwarded-Proto.
TRUST_PROXY_HTTPS=false
# PythonAnywhere alone: its managed proxy supplies X-Real-IP for client limits.
TRUST_PYTHONANYWHERE_PROXY=false
# GOOGLE_SITE_VERIFICATION= (only the actual token issued by Google Search Console)
# RESULT_DIR=/private/ephemeral/toolsathi-results
# APK_DIR=/srv/toolsathi/artifacts
